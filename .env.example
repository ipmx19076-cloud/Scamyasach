# Copy to .env.local for local development. Never commit real keys.
# Set ONE of these. If both are set, Anthropic is used unless AI_PROVIDER says otherwise.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional
# AI_PROVIDER=openai            # force a provider: openai or anthropic
# OPENAI_MODEL=gpt-4o-mini      # any OpenAI model that supports structured outputs
# CHECK_MODEL=claude-sonnet-5-5 # Claude model when using Anthropic
